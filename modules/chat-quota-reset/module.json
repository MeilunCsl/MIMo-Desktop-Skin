  "runtimeEntry": "windows/assets/renderer-inject.js",
  "styleEntry": "windows/assets/dream-skin.css",
  "functions": [
    "ensureQuotaComposerPortal",
    "ensureComposerQuotaRing",
    "positionQuotaRingSurface",
    "quotaResetRadarSnapshot",
    "refreshTiboRadar"
  ],
  "domIds": [
    "codex-quota-composer-portal",
    "codex-quota-ring-composer",
    "codex-quota-ring-details",
    "codex-quota-reset-composer",
    "codex-quota-reset-details"
  ],
  "stateAttributes": [
    "data-selected",
    "data-outcome",
    "data-level",
    "data-freshness"
  ],
  "configKeys": [
    "quota.enabled",
    "quota.radar.tiboRefreshMs"
