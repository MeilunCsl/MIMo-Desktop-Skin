{
  "id": "skin-core",
  "name": "皮肤核心契约",
  "runtimeEntry": "windows/scripts/injector.mjs + windows/assets/renderer-inject.js",
  "configFiles": [
    "windows/assets/theme.json",
    "windows/assets/selectors.json",
    "windows/assets/dream-skin.css"
  ],
  "resourceRules": {
    "themeImages": "relative and inside selected theme directory",
    "maxImageBytes": 16777216,
    "maxBackgroundVariants": 4,
    "supportedFormats": ["png", "jpg", "jpeg", "webp"]
  },
  "designTokens": {
    "color": "--ds-*",
    "art": "--dream-*",
    "route": "data-dream-*"
  },
  "mustPreserve": [
    "native Codex controls and accessibility",
    "loopback-only CDP",
    "idempotent ensure and cleanup",
    "selector contract tiers L1/L2"
  ]
}
