{
  "id": "theme-switching",
  "name": "主题切换",
  "runtimeEntry": "windows/assets/renderer-inject.js",
  "scriptEntry": "windows/scripts/switch-dream-skin.ps1",
  "functions": [
    "applyTheme",
    "applyArtMetadata",
    "setActiveBackgroundVariant",
    "themeOptions",
    "setActiveThemeOption",
    "nativeThemeOption",
    "ensureBackgroundSwitcher",
    "Initialize-DreamSkinThemeStore",
    "Set-DreamSkinActiveTheme",
    "Use-DreamSkinSavedTheme"
  ],
  "storageKeys": [
    "codex-dream-background-variant",
    "codex-dream-theme-selection"
  ],
  "configFiles": [
